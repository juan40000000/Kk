<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Metro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">#FF1F1F1F</item>
        <item name="android:colorAccent">#FF1BA1E2</item>
        <item name="android:colorPrimary">#FF000000</item>
        <item name="android:colorPrimaryDark">#FF000000</item>
        <item name="android:alertDialogTheme">@style/Theme.Metro.Dialog</item>
    </style>

    <style name="Theme.Metro.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#FF1BA1E2</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>
